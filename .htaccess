# Ruka Kalen — configuración para hosting Apache (cPanel, Plesk, etc.)
# Este archivo es opcional: el sitio funciona sin él. Solo agrega tipos MIME,
# caché, compresión y cabeceras de seguridad.
# En GitHub Pages / Netlify / Cloudflare Pages se ignora.

# Página principal y errores
DirectoryIndex index.html
ErrorDocument 404 /404.html

# No listar directorios ni permitir acceso a archivos ocultos
Options -Indexes

<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>

# Tipos MIME (algunos hostings antiguos no los traen)
AddType font/woff2 .woff2
AddType image/svg+xml .svg
AddType image/webp .webp

# Codificación
AddDefaultCharset UTF-8

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain image/svg+xml application/json
</IfModule>

# Caché
# El HTML no se cachea para que los cambios se vean de inmediato.
# Los recursos estáticos se cachean pocos días porque los nombres de archivo
# no cambian entre versiones. Si reemplazas un archivo, ajusta estos valores.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # HSTS: activar solo cuando el dominio funcione con HTTPS y sea definitivo.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Redirigir todo a HTTPS. Descomentar cuando el certificado SSL esté activo.
# Si el sitio vive en un subdirectorio, ajusta la regla.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
